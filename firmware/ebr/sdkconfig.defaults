# Spike: the border router as a Matter-over-Thread device (notes/matter-device.md, "Plan", step 3).
# From esp-matter's thread_border_router example, for the Waveshare ESP32-P4-ETH + the H2 (Thread RCP on UART1,
# BLE controller on UART2). Never put a Thread dataset in here.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Stacks (example)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=7200
CONFIG_ESP_MAIN_TASK_STACK_SIZE=7200
CONFIG_ESP_TIMER_TASK_STACK_SIZE=5120
CONFIG_THREAD_TASK_STACK_SIZE=8192
CONFIG_CHIP_TASK_STACK_SIZE=10240

# Bluetooth: NimBLE host on the P4, the H2's controller over HCI on UART2 (TX GPIO22 → H2 "10", RX GPIO23 ← H2 "11")
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=y
CONFIG_BT_NIMBLE_TRANSPORT_UART_PORT=2
CONFIG_UART_BAUDRATE_115200=y
CONFIG_BT_NIMBLE_UART_TX_PIN=22
CONFIG_BT_NIMBLE_UART_RX_PIN=23
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# events up to the H2 controller's size (BT_LE_HCI_EVT_BUF_SIZE 257)
CONFIG_BT_NIMBLE_TRANSPORT_EVT_SIZE=257

# lwIP (border router)
CONFIG_LWIP_IPV6_FORWARD=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=12
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_HOOK_IP6_INPUT_CUSTOM=y
CONFIG_LWIP_HOOK_IP6_SELECT_SRC_ADDR_CUSTOM=y
CONFIG_ENABLE_ROUTE_HOOK=n

CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_ECJPAKE_C=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# OpenThread: border router, the H2 as RCP over UART; the H2 shares its radio with BLE, so no rx-on-when-idle
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y
CONFIG_OPENTHREAD_BORDER_ROUTER=y
CONFIG_OPENTHREAD_RADIO_SPINEL_UART=y
CONFIG_OPENTHREAD_RX_ON_WHEN_IDLE=n
CONFIG_OPENTHREAD_CLI=y
CONFIG_AUTO_UPDATE_RCP=y
CONFIG_RCP_SRC_DIR="$ENV{BR_RCP_BUILD_DIR}"

# Matter: a Thread device (the Thread driver on endpoint 0 takes the dataset during pairing), no Wi-Fi
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_ENABLE_WIFI_AP=n
CONFIG_THREAD_NETWORK_COMMISSIONING_DRIVER=y
# Keep BLE after pairing: shutting NimBLE down with the UART transport hangs the CHIP task forever
# ("hal_uart: Waiting for uart task finish...", the RX task never leaves its queue wait) - found 2026-10-20
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n
CONFIG_ENABLE_CHIP_SHELL=y
CONFIG_ENABLE_OTA_REQUESTOR=n
CONFIG_USE_MINIMAL_MDNS=n
CONFIG_MDNS_MULTIPLE_INSTANCE=y
CONFIG_MDNS_MAX_SERVICES=50
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=2
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SUPPORT_GROUPCAST_CLUSTER=n

# The status display (components/br_display): LVGL, the QR code widget for the pairing screen
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_USE_OBSERVER=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

# PSRAM (32 MB on the P4 module)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Ethernet (internal EMAC, IP101 at address 1, MDC 31, MDIO 52, PHY reset 51 on the Waveshare board)
CONFIG_EXAMPLE_CONNECT_ETHERNET=y
CONFIG_EXAMPLE_CONNECT_WIFI=n
CONFIG_EXAMPLE_USE_INTERNAL_ETHERNET=y
CONFIG_EXAMPLE_ETH_PHY_IP101=y
CONFIG_EXAMPLE_ETH_PHY_ADDR=1
CONFIG_EXAMPLE_ETH_MDC_GPIO=31
CONFIG_EXAMPLE_ETH_MDIO_GPIO=52
CONFIG_EXAMPLE_ETH_PHY_RST_GPIO=51
CONFIG_EXAMPLE_CONNECT_IPV6=y
